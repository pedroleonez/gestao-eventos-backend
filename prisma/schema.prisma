// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  // Relação 1:N - Um usuário pode organizar muitos eventos
  organizedEvents Event[] @relation("UserEvents")

  // Relação N:N (via tabela de junção) - Eventos em que o usuário se inscreveu
  registrations Registration[]

  @@map("users")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  date        DateTime
  location    String
  capacity    Int
  createdAt   DateTime @default(now())

  // Chave estrangeira para o organizador
  organizerId String
  organizer   User   @relation("UserEvents", fields: [organizerId], references: [id])

  // Inscrições vinculadas a este evento
  registrations Registration[]

  @@map("events")
}

model Registration {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Relação com Usuário
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Relação com Evento
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  // Garante que o mesmo usuário não se inscreva no mesmo evento duas vezes
  @@unique([userId, eventId])
  @@map("registrations")
}
